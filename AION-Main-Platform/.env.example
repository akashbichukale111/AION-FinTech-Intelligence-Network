# All optional. AION shows honest "not configured" states when these are empty.
# Base URL of a backend exposing GET /paypal/status and POST /paypal/create-order.
# PayPal Client ID/Secret belong ONLY on that backend, never in this frontend.
VITE_AION_API_BASE=
# URLs of separately deployed workspace applications (enables the "Open workspace" button).
VITE_AURA_URL=
VITE_FORGEX_URL=

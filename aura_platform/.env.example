# =============================================================================
# AURA Financial Intelligence & Resolution Platform - Environment Configuration
# =============================================================================

# Application Core
APP_NAME="AURA Financial Intelligence & Resolution Platform"
APP_VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database (defaults to local SQLite if left empty; PostgreSQL supported)
DATABASE_URL=sqlite:///D:/AION/aura_platform/data/aura.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/aura_db

# Security & RBAC
SECRET_KEY=aura_super_secure_secret_key_financial_ai_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_API_KEY=aura_live_api_key_sandbox_2026

# =============================================================================
# PAYPAL SANDBOX & LIVE INTEGRATION
# =============================================================================
# Mode: 'sandbox' or 'live'
PAYPAL_MODE=sandbox

# REST API Credentials (Obtain from https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional Webhook ID (from Webhook configuration in PayPal Developer Dashboard)
PAYPAL_WEBHOOK_ID=

# Base URL (Auto-selected based on PAYPAL_MODE if left blank)
# Sandbox: https://api-m.sandbox.paypal.com
# Live: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# =============================================================================
# LLM / AI ENGINE (OPTIONAL FOR COPILOT)
# =============================================================================
GEMINI_API_KEY=
COPILOT_MODEL=gemini-1.5-flash
